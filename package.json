  "description": "Lapka: a local anime player. Paste a link, it finds the episodes and the dubs, plays them and saves them to your folder.",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/MythHand/Lapka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MythHand/Lapka.git"
  },
  "bugs": {
    "url": "https://github.com/MythHand/Lapka/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
